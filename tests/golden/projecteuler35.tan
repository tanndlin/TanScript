def isPrime(n: u32): bool {
    if n == 2 {
        return true;
    }

    if n < 2 || n % 2 == 0 {
        return false;
    }

    for(let i = 3; i*i <= n; i += 2) {
        if n % i == 0 {
            return false;
        }
    }

    true
}

def numDigits(n: u32): u32 {
    let digits = 0;
    while n > 0 {
        n /= 10;
        digits++;
    }

    digits
}

def pow(base: u32, expo: u32): u32 {
    let n = 1;
    for(let i = 0; i < expo; i++){
        n *= base;
    }

    n
}

def rotate(n: u32): u32 {
    (n / 10) + (n % 10) * pow(10, numDigits(n) - 1)
}

def isCircularPrime(n: u32): bool {
    if n < 10 {
        return isPrime(n);
    }

    if !isPrime(n) {
        return false;
    }

    let rotated = rotate(n);
    while rotated != n {
        if !isPrime(rotated) {
            return false;
        }

        rotated = rotate(rotated);
    }

    true
}

let total = 0;
for(let i = 0; i < 1000000; i++) {
    total += isCircularPrime(i);
}

printf("%d\n", total);