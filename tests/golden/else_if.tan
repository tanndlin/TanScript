for (let i = 1; i <= 15; i++) {
    if i % 15 == 0 {
        printf("FizzBuzz\n");
    } else if i % 3 == 0 {
        printf("Fizz\n");
    } else if i % 5 == 0 {
        printf("Buzz\n");
    } else {
        printf("%d\n", i);
    }
}

def grade(score: u32): char {
    let letter: char = 'F';
    if score >= 90 {
        letter = 'A';
    } else if score >= 80 {
        letter = 'B';
    } else if score >= 70 {
        letter = 'C';
    }

    letter
}

printf("%c %c %c %c\n", grade(95), grade(85), grade(72), grade(10));
