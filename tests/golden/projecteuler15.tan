let N = 21;

let ways: **u64 = malloc(8 * N);
for(let i = 0; i < N; i++) {
    ways[i] = malloc(8 * N);

    for(let j = 0; j < N; j++) {
        ways[i][j] = 0;
    }
}

ways[0][0] = 1;
for(let i = 0; i < N; i++) {
    for(let j = 0; j < N; j++) {
        if i > 0 {
            ways[i][j] += ways[i-1][j];
        }

        if j > 0 {
            ways[i][j] += ways[i][j-1];
        }
    }
}


printf("%lld\n", ways[N-1][N-1]);