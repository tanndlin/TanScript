use math::{isPrime, numDigits, pow};

def rotate(n: u32): u32 {
    (n / 10) + (n % 10) * pow(10, numDigits(n) - 1)
}

def isCircularPrime(n: u32): bool {
    if n < 10 {
        return isPrime(n);
    }

    if !isPrime(n) {
        return false;
    }

    let rotated = rotate(n);
    while rotated != n {
        if !isPrime(rotated) {
            return false;
        }

        rotated = rotate(rotated);
    }

    true
}

let total = 0;
for(let i = 0; i < 1000000; i++) {
    total += isCircularPrime(i);
}

printf("%d\n", total);