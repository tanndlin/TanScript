def isAlphanumeric(c: char): bool {
    isAlphabetic(c) || (c >= '0' && c <= '9')
}

def isIdentStart(c: char): bool {
    isAlphabetic(c) || c == '_'
}

def isIdentChar(c: char): bool {
    isAlphanumeric(c) || c == '_'
}

def isAlphabetic(c: char): bool {
    (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
}