use list::{list_push, list_with_capacity};

struct Node<T> {
    value: T,
    next: *Node<T>,
}

def linked_list_push<T>(node: *Node<T>, value: T) {
    while node->next != null {
        node = node->next;
    }

    let new_node: *Node<T> = calloc(1, sizeof(Node<T>));
    new_node->value = value;
    node->next = new_node;
}

def linked_list_to_list<T>(node: *Node<T>): List<T> {
    let length: u32 = 0;
    let ptr = node;
    while ptr != null {
        ptr = ptr->next;
        length++;
    }

    let list: List<T> = list_with_capacity(length);
    for i in 0..length {
        list_push(&list, node->value);
        node = node->next;
    }

    list
}
