def sumOfDivisors(n: u32): u32 {
    let sum = 0;

    for(let i = 1; i * i <= n; i++) {
        if n % i == 0 {
            if i == 1 || i * i == n {
                sum += i;
            } else {
                sum += i + (n / i);
            }
        }
    }

    sum
}

let sum = 0;
for(let a = 1; a < 10000; a++) {
    let sumA = sumOfDivisors(a);
    sum += (a < sumA && sumA < 10000 && sumOfDivisors(sumA) == a) * (a + sumA);
}

printf("%d\n", sum);