let a: char = 'a';
let z: char = 'Z';
printf("%c %c\n", a, z);
printf("%d %d %d\n", 'a', '0', '\n');

putchar('h');
putchar('i');
putchar('\n');

let digit: char = '7';
printf("%d\n", digit - '0');

let c: char = 'a';
c++;
c += 1;
printf("%c\n", c);

if (c == 'c') {
    printf("is c\n");
}

let s: *char = malloc(4);
s[0] = 'o';
s[1] = 'k';
s[2] = '\n';
s[3] = '\0';
printf("%s", s);

for (let i = 0; i < 3; i++) {
    let letter: char = s[i];
    putchar(letter);
}
