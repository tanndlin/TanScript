def mergeSort(arr: **char, start: u32, end: u32) {
    if start >= end {
        return;
    }

    let mid = (start + end) / 2;
    mergeSort(arr, start, mid);
    mergeSort(arr, mid + 1, end);

    let temp: **char = malloc((end - start + 1) * 8);

    let i = start;
    let j = mid + 1;
    let k = 0;

    while i <= mid && j <= end {
        if strcmp(arr[i], arr[j]) < 0 {
            temp[k++] = arr[i++];
        } else {
            temp[k++] = arr[j++];
        }
    }

    while i <= mid {
        temp[k++] = arr[i++];
    }

    while j <= end {
        temp[k++] = arr[j++];
    }

    for(let i = 0; i < k; i++) {
        arr[start + i] = temp[i];
    }
}


def nameScore(name: *char, length: u32): u32 {
    let score = 0;
    for(let i = 0; i < length; i++) {
        score += name[i] as u32 - 64;
    }

    score
}

let fp = fopen("names.txt", "rb");
fflush(0);

let total = 0;
let index = 0;

let numNames = 5163;
let names: **char = malloc(8 * numNames);

let buf: *char = malloc(12);
while fscanf(fp, "\"%[^\"]\",", buf) == 1 {
    names[index++] = buf;
    buf = malloc(12);
}

mergeSort(names, 0, numNames-1);

for(let i = 0; i < numNames; i++) {
    total += nameScore(names[i], strlen(names[i])) * (i + 1);
}

printf("Total: %d\n", total);