def isPrime(n: u32, primes: *u32, numPrimes: u32): bool {
    for(let i = 0; i < numPrimes && primes[i] * primes[i] <= n; i++) {
        if n % primes[i] == 0 {
            return false;
        }
    }

    true
}

struct PrimeList {
    arr: *u32,
    length: u32,
}

let primes = PrimeList {
    arr: malloc(4 * 150000),
    length: 2,
};
primes.arr[0] = 2;
primes.arr[1] = 3;

for(let n = 5; n < 2000000; n += 2) {
    if isPrime(n, primes.arr, primes.length) {
        primes.arr[primes.length] = n;
        primes.length++;
    }
}


let sum: u64 = 0;
for(let i = 0; i < primes.length; i++) {
    sum += primes.arr[i];
}

printf("%llu\n", sum);