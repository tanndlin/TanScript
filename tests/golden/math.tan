def isPrime(n: u32): bool {
    if n == 2 {
        return true;
    }

    if n < 2 || n % 2 == 0 {
        return false;
    }

    let i = 3;
    while i*i <= n {
        if n % i == 0 {
            return false;
        }
        i += 2;
    }

    true
}

def isPandigital(n: u64): bool {
    let digits: *bool = malloc(9);
    for i in 0..9 {
        digits[i] = false;
    }

    while n > 0 {
        let pop = n % 10;
        if pop != 0 {
            digits[pop - 1] = true;
        }

        n /= 10;
    }

    let ret = true;
    for i in 1..=9 {
        if !digits[i-1] {
            ret = false;
            break;
        }
    }

    free(digits);
    ret
}

def numDigits(n: u32): u32 {
    let digits = 0;
    while n > 0 {
        n /= 10;
        digits++;
    }

    digits
}

def pow(base: u32, expo: u32): u32 {
    let n = 1;
    for i in 0..expo {
        n *= base;
    }

    n
}

def reversed(n: u32): u32 {
    let r = 0;
    while n > 0 {
        r = r * 10 + n % 10;
        n /= 10;
    }

    r
}

def isPalindrome(n: u32): bool {
    reversed(n) == n
}