def sumOfDivisors(n: u32): u32 {
    let sum = 0;

    let i = 1;
    while i * i <= n {
        if n % i == 0 {
            if i == 1 || i * i == n {
                sum += i;
            } else {
                sum += i + (n / i);
            }
        }
        i++;
    }

    sum
}

let sum = 0;
for a in 1..10000 {
    let sumA = sumOfDivisors(a);
    sum += (a < sumA && sumA < 10000 && sumOfDivisors(sumA) == a) * (a + sumA);
}

printf("%d\n", sum);