def isPrime(n: u32, primes: *u32, numPrimes: u32): bool {
    let i = 0;
    while i < numPrimes && primes[i] * primes[i] <= n {
        if n % primes[i] == 0 {
            return false;
        }
        i++;
    }

    true
}

struct PrimeList {
    arr: *u32,
    length: u32,
}

let primes = PrimeList {
    arr: malloc(150000 * sizeof(u32)),
    length: 2,
};
primes.arr[0] = 2;
primes.arr[1] = 3;

let n = 5;
while n < 2000000 {
    if isPrime(n, primes.arr, primes.length) {
        primes.arr[primes.length] = n;
        primes.length++;
    }
    n += 2;
}


let sum: u64 = 0;
for i in 0..primes.length {
    sum += primes.arr[i];
}

printf("%llu\n", sum);