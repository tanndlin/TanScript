let N = 21;

let ways: **u64 = malloc(N * sizeof(*u64));
for i in 0..N {
    ways[i] = malloc(N * sizeof(u64));

    for j in 0..N {
        ways[i][j] = 0;
    }
}

ways[0][0] = 1;
for i in 0..N {
    for j in 0..N {
        if i > 0 {
            ways[i][j] += ways[i-1][j];
        }

        if j > 0 {
            ways[i][j] += ways[i][j-1];
        }
    }
}


printf("%lld\n", ways[N-1][N-1]);