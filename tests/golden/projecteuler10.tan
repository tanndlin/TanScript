def isPrime(n: u32, primes: *u32, numPrimes: u32): bool {
    for(let i = 0; i < numPrimes && primes[i] * primes[i] <= n; i++) {
        if n % primes[i] == 0 {
            return false;
        }
    }

    true
}

let primes: *u32 = malloc(4 * 150000);
primes[0] = 2;
primes[1] = 3;
let numPrimes = 2;

for(let n = 5; n < 2000000; n += 2) {
    if isPrime(n, primes, numPrimes) {
        primes[numPrimes] = n;
        numPrimes++;
    }
}


let sum: u64 = 0;
for(let i = 0; i < numPrimes; i++) {
    sum += primes[i];
}

printf("%llu\n", sum);