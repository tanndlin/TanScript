enum Color {
    Red,
    Green,
    Blue,
}

def color_name(c: Color): char {
    let letter: char = '?';
    match c {
        Color::Red => letter = 'R';
        Color::Green => letter = 'G';
        Color::Blue => letter = 'B';
    };
    letter
}

printf("%c %c %c\n", color_name(Color::Red), color_name(Color::Green), color_name(Color::Blue));

for (let i = 0; i < 5; i++) {
    match i {
        0 => printf("zero\n");
        1 => printf("one\n");
        2 => {
            printf("two\n");
            printf("still two\n");
        }
        3 => printf("three\n");
    };
}

def first_match(x: i32): i32 {
    match x {
        1 => return 10;
        1 => return 20;
        2 => return 30;
    };
    return -1;
}

printf("%d %d %d\n", first_match(1), first_match(2), first_match(7));

let grade: char = 'B';
match grade {
    'A' => printf("great\n");
    'B' => printf("good\n");
    'C' => printf("ok\n");
};

let a = 2;
let b = Color::Green;
match a {
    1 => printf("a is one\n");
    2 => {
        match b {
            Color::Red => printf("a two, b red\n");
            Color::Green => printf("a two, b green\n");
            Color::Blue => printf("a two, b blue\n");
        };
    }
};

let n = 4;
match n * 2 {
    4 => printf("four\n");
    8 => printf("eight\n");
};

match n {
    1 => printf("unreachable\n");
};
printf("done\n");

def describe(x: i32): i32 {
    let kind = 0;
    match x {
        1 => kind = 1;
        2 => kind = 2;
        _ => kind = 99;
    };
    kind
}

printf("%d %d %d %d\n", describe(1), describe(2), describe(3), describe(-5));

let shade = Color::Blue;
match shade {
    Color::Red => printf("warm\n");
    _ => {
        printf("cool\n");
        printf("not red\n");
    }
};

match n {
    _ => printf("always\n");
};

let hit = Color::Red;
match hit {
    Color::Red => printf("matched before catch-all\n");
    _ => printf("catch-all should not run\n");
};
