use projecteuler21::{sumOfDivisors};

let abundants: *bool = malloc(28123 + 1);
abundants[0] = false;
for i in 1..=28123 {
    abundants[i] = sumOfDivisors(i) > i;
}

let sum = 0;
for i in 1..=28123 {
    let found = false;
    for a in 1..=i / 2 {
        if abundants[a] && abundants[i - a] {
            found = true;
            break;
        }
    }

    if !found {
        sum += i;
    }
}


printf("%d\n", sum);